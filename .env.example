# Copy to .env (repo root, used by docker compose) and/or backend/.env (local uvicorn/celery).

# --- App ------------------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# REQUIRED: >= 32 random chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- PostgreSQL -----------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=storepulse
POSTGRES_PASSWORD=storepulse
POSTGRES_DB=storepulse

# --- Redis / Celery -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=        # defaults to REDIS_URL; sqla+postgresql+psycopg://user:pw@host:port/db uses
#                           # PostgreSQL as the broker (lean local runs: backend/scripts/local_stack.py)
# CELERY_RESULT_BACKEND=    # defaults to REDIS_URL
CELERY_CONCURRENCY=2

# --- Artifact storage -----------------------------------------------------------------
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_ROOT=./storage
STORAGE_CACHE_DIR=./storage/.cache
S3_BUCKET=storepulse-artifacts
# S3_ENDPOINT_URL=http://minio:9000   # MinIO / R2 / other S3-compatible
S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Ingestion / ML -------------------------------------------------------------------
MAX_UPLOAD_MB=2048
INGESTION_CHUNK_ROWS=500000
TRAINING_DEVICE=auto             # auto | cpu | cuda
OPTUNA_DEFAULT_TRIALS=30
# OPTUNA_STORAGE_URL=postgresql+psycopg://storepulse:storepulse@localhost:5432/storepulse

# --- Frontend -------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
